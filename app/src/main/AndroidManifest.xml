<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 基础网络与通知权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务（Android 9+ 必需），以及 mediaProjection 子类型（Android 14+ 必需） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".FocusAiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusAI"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            视觉监督前台服务：持有 MediaProjection、ImageReader、VirtualDisplay
            foregroundServiceType 必须显式声明 mediaProjection，否则 Android 14+ 会抛
            SecurityException: Media projections require a foreground service of type
            ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PROJECTION.
        -->
        <service
            android:name=".service.VisualSupervisionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            无障碍服务：仅用于执行 performGlobalAction(GLOBAL_ACTION_HOME)，
            不再扫描节点文本。事件类型保留最低集合以满足框架注册约束。
        -->
        <service
            android:name=".service.FocusAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
